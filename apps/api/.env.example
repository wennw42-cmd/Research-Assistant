# ───────────────────────────── LLM / 模型厂商 ─────────────────────────────
# mock = 离线脚本化模型（无需密钥，demo/自测可用）；openai_compatible = 任意 OpenAI 兼容接口
LLM_PROVIDER=mock
LLM_API_KEY=
# 阿里云百炼 OpenAI 兼容地址（qwen-plus / qwen-max / qwen-turbo）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# 多模态：图片理解 / 文生图
VISION_MODEL=qwen3-vl-plus
IMAGE_MODEL=wanx2.1-t2i-turbo
IMAGE_API_BASE=https://dashscope.aliyuncs.com/api/v1
IMAGE_TIMEOUT=180

# ───────────────────────────── Embedding / Rerank ─────────────────────────────
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_BASE_URL=

# ───────────────────────────── Agent 运行时 ─────────────────────────────
AGENT_MAX_REVISION=2
AGENT_MAX_TOOL_STEPS=4
# true = 在 executor 节点前中断，等待人工确认（HITL）
AGENT_HITL=false
RETRIEVAL_TOP_K=6

# ───────────────────────────── 存储 ─────────────────────────────
# 翻译历史 SQLite；相对路径按 apps/api 解析，Navicat 可直接打开该文件
SQLITE_PATH=data/research_assistant.db
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/research_assistant
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ───────────────────────────── 外部学术服务 ─────────────────────────────
OPENALEX_MAILTO=you@example.edu
CROSSREF_MAILTO=you@example.edu
SEMANTIC_SCHOLAR_KEY=

# ───────────────────────────── OCR（Tesseract）─────────────────────────────
# 中文扫描件用 chi_sim+eng；仅英文用 eng
OCR_LANG=eng
# 留空自动查找 PATH / 默认安装目录
TESSERACT_CMD=
# 自定义语言包目录；留空用 Tesseract 默认 tessdata
TESSDATA_PREFIX=

# ───────────────────────────── 可观测 ─────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO
